# Copy to evals/.env (gitignored) for local runs. `cli.py` loads it via
# python-dotenv; nothing here has a default in code (#85's fail-loud config).

# LiteLLM's OpenAI-compatible chat-completions base URL (typically ending
# in `/v1`) and the dedicated eval virtual key -- isolated from production
# traffic/spend, per #85. Same key authenticates the MCP route below too.
LITELLM_BASE_URL=https://litellm.example.internal/v1
LITELLM_EVAL_API_KEY=sk-eval-...

# The model under test and the judge model, exactly as registered in
# LiteLLM. Deliberately no default in code -- #85 leaves the exact choice
# to whatever production LiteLLM actually runs. The two must differ
# (self-preference bias, enforced); the judge should also be the *stronger*
# of the two (#85), which is a choice this harness can't verify for you.
EVAL_MODEL=
EVAL_JUDGE_MODEL=

# Required -- deliberately not derived from LITELLM_BASE_URL, since that's
# the chat-completions base (needs `/v1`) and this is LiteLLM's MCP
# passthrough route hung off the proxy *root*
# (docs/ops/deploy-runbook.md's verification step 2): the same path an
# architect's agent actually uses. Point at the engine directly instead
# (e.g. `http://127.0.0.1:8848/mcp`) only when running from the box itself.
URBANDOCS_MCP_URL=https://litellm.example.internal/normativa/mcp

# Read directly by the `langfuse` SDK, from the Langfuse project's API keys.
# LANGFUSE_BASE_URL is required -- the SDK would otherwise default to
# Langfuse Cloud (EU); set it to the self-hosted instance or the cloud
# region the project lives in.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://langfuse.example.internal

# Optional. Defaults to `urbandocs-gold-set`.
LANGFUSE_DATASET=

# Optional. Defaults to 50. Caps model requests per question -- the
# enforced version of "runs until it produces a final answer, or stops"
# (#85). A run that hits the cap is graded on its stalled output, not
# retried indefinitely.
EVAL_MAX_REQUESTS=
